{
  "name": "synqdb-agent",
  "version": "1.2.0",
  "description": "Local database relay agent for SynqDB \u2014 connects your local MySQL, PostgreSQL, SQL Server and SQLite databases to the SynqDB dashboard",
  "main": "index.js",
  "bin": {
    "synqdb-agent": "index.js"
  },
  "scripts": {
    "start": "node index.js"
  },
  "keywords": [
    "agent",
    "database",
    "mssql",
    "mysql",
    "postgres",
    "relay",
    "sqlite",
    "synqdb"
  ],
  "dependencies": {
    "dotenv": "^17.2.3",
    "mssql": "^11.0.1",
    "mysql2": "^3.6.0",
    "pg": "^8.11.0",
    "socket.io-client": "^4.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
